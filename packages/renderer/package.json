{
  "name": "@mapbard/renderer",
  "version": "0.1.1",
  "description": "Static map-story renderer with a bundled MapLibre browser player for MapBard",
  "keywords": [
    "mapbard",
    "maplibre",
    "geospatial",
    "storytelling",
    "renderer"
  ],
  "homepage": "https://github.com/GeoScenarioScripter/map-bard/tree/main/packages/renderer#readme",
  "bugs": "https://github.com/GeoScenarioScripter/map-bard/issues",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/GeoScenarioScripter/map-bard.git",
    "directory": "packages/renderer"
  },
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "runtime"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./player.js": "./dist/player/player.js",
    "./vendor/maplibre-gl.js": "./dist/vendor/maplibre-gl.js",
    "./vendor/maplibre-gl-worker.js": "./dist/vendor/maplibre-gl-worker.js"
  },
  "scripts": {
    "build": "node ../../scripts/clean-package-dist.mjs renderer && tsc -p tsconfig.json && tsc -p player/tsconfig.json && node scripts/build-player.mjs && node scripts/build-maplibre.mjs",
    "build:player": "tsc -p player/tsconfig.json && node scripts/build-player.mjs",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@fontsource-variable/inter": "5.3.0",
    "@fontsource-variable/source-serif-4": "5.3.0",
    "@mapbard/schema": "workspace:*",
    "maplibre-gl": "6.1.0"
  },
  "devDependencies": {
    "@mapbard/core": "workspace:*",
    "@mapbard/knowledge": "workspace:*",
    "esbuild": "0.21.5"
  }
}
