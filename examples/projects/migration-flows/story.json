      "id": "overview",
      "title": "The largest moves between states",
      "narration": "The 30 largest state-to-state flows in the 2024 American Community Survey, each an estimated 27,574 movers or more. California to Texas leads with 77,161 (±9,059). Width is linear from zero; colour runs from origin to destination.",
      "content": {
        "semantics": "People who lived in another state one year earlier, by origin and destination state.",
        "location": "The 50 states and DC, between 2020 state centers of population.",
        "geometry": "One arc per origin and destination pair.",
        "attribute": "movers in people, with 90% margins of error"
      },
      "discourse": {
        "narrativeRole": "establish",
        "emphasis": "medium",
        "readerAgency": "guided"
      },
