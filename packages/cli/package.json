{
  "name": "mapbard",
  "version": "0.1.0",
  "description": "Command-line authoring and publishing for traceable map stories",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/GeoScenarioScripter/map-bard.git",
    "directory": "packages/cli"
  },
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "bin": {
    "mapbard": "./dist/bin.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/copy-skill.mjs",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@mapbard/core": "workspace:*",
    "@mapbard/knowledge": "workspace:*",
    "@mapbard/renderer": "workspace:*",
    "@mapbard/schema": "workspace:*",
    "commander": "14.0.3"
  }
}
