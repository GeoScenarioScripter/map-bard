{
  "name": "mapbard",
  "version": "0.1.2",
  "description": "CLI for validating plain-file map projects and publishing traceable static map stories",
  "keywords": [
    "map",
    "storytelling",
    "geospatial",
    "geojson",
    "cli",
    "visualization"
  ],
  "homepage": "https://github.com/GeoScenarioScripter/map-bard#readme",
  "bugs": "https://github.com/GeoScenarioScripter/map-bard/issues",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/GeoScenarioScripter/map-bard.git",
    "directory": "packages/cli"
  },
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "bin": {
    "mapbard": "./dist/bin.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/copy-skill.mjs",
    "test": "vitest run --passWithNoTests --testTimeout 20000"
  },
  "dependencies": {
    "@mapbard/core": "workspace:*",
    "@mapbard/knowledge": "workspace:*",
    "@mapbard/renderer": "workspace:*",
    "@mapbard/schema": "workspace:*",
    "commander": "14.0.3",
    "pixelmatch": "7.2.0",
    "playwright-core": "1.64.1",
    "pngjs": "7.0.0"
  },
  "devDependencies": {
    "@types/pngjs": "6.0.5"
  }
}
