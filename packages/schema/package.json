{
  "name": "@mapbard/schema",
  "version": "0.2.0",
  "description": "Versioned Zod and JSON Schema contracts for MapBard projects, stories, and publications",
  "keywords": [
    "mapbard",
    "zod",
    "json-schema",
    "geospatial",
    "validation"
  ],
  "homepage": "https://github.com/GeoScenarioScripter/map-bard/tree/main/packages/schema#readme",
  "bugs": "https://github.com/GeoScenarioScripter/map-bard/issues",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/GeoScenarioScripter/map-bard.git",
    "directory": "packages/schema"
  },
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./easing": {
      "types": "./dist/easing.d.ts",
      "default": "./dist/easing.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "zod": "^3.24.1",
    "zod-to-json-schema": "3.24.6"
  }
}
