# MapBard LLM configuration — DashScope (Alibaba Qwen) via the OpenAI-compatible
# endpoint. Copy this file to `.env` and fill in your key. Never commit `.env`.

# Required: your DashScope API key.
MAPBARD_LLM_KEY=

# Optional: the OpenAI-compatible base URL. Defaults to the value below.
# MAPBARD_LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# Optional: the model id. Defaults to the value below.
# MAPBARD_LLM_MODEL=qwen3.7-max-2026-05-17
