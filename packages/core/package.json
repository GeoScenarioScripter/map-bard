{
  "name": "@mapbard/core",
  "version": "0.1.0",
  "description": "Project loading, validation, compilation, and source profiling for MapBard",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/GeoScenarioScripter/map-bard.git",
    "directory": "packages/core"
  },
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "node ../../scripts/clean-package-dist.mjs core && tsc -p tsconfig.json",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@mapbard/knowledge": "workspace:*",
    "@mapbard/schema": "workspace:*",
    "zod": "^3.24.1"
  }
}
