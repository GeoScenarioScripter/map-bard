{
  "formatVersion": "0.2.0",
  "id": "migration-flows",
  "title": "Moving between states, 2024",
  "intent": "Show the 30 largest 2024 state-to-state migration flows from the American Community Survey as arcs, largest first, with a closer look at the East Coast, while keeping every estimate's 90% margin of error visible.",
  "theme": {
    "preset": "newsroom"
  },
  "layout": "full-bleed",
  "basemap": {
    "provider": "openfreemap",
    "style": "positron",
    "labels": "minimal",
    "fallback": ["versatiles"],
    "projection": "mercator"
  },
  "resources": {
    "data": [
      {
        "id": "states-context",
        "kind": "geojson",
        "path": "data/census-2024-states-context.geojson",
        "crs": "EPSG:4326",
        "featureId": {
          "method": "geojson-id",
          "scope": "source"
        },
        "attributes": [
          {
            "name": "name",
            "observedType": "string",
            "inferredLevel": "nominal",
            "role": "identifier",
            "level": "nominal",
            "unit": null,
            "label": "State"
          }
        ],
        "attribution": {
          "label": "U.S. Census Bureau 2024 generalized state boundaries (TIGERweb)",
          "url": "https://tigerweb.geo.census.gov/arcgis/rest/services/Generalized_ACS2024/State_County/MapServer/8",
          "license": "U.S. public domain",
          "accessedAt": "2026-11-04T00:00:00Z",
          "qualification": "Local geographic context only, simplified to about 0.05 degrees; the outlines carry no migration data."
        },
        "name": "2024 generalized state outlines"
      },
      {
        "id": "state-flows",
        "kind": "geojson",
        "path": "data/acs-2024-top-state-flows.geojson",
        "crs": "EPSG:4326",
        "featureId": {
          "method": "geojson-id",
          "scope": "source"
        },
        "attributes": [
          {
            "name": "origin",
            "observedType": "string",
            "inferredLevel": "nominal",
            "role": "category",
            "level": "nominal",
            "unit": null,
            "label": "State of residence one year ago"
          },
          {
            "name": "destination",
            "observedType": "string",
            "inferredLevel": "nominal",
            "role": "category",
            "level": "nominal",
            "unit": null,
            "label": "State of current residence"
          },
          {
            "name": "movers",
            "observedType": "number",
            "inferredLevel": "ratio",
            "role": "quantity",
            "level": "ratio",
            "unit": "people",
            "label": "Movers"
          },
          {
            "name": "movers_moe",
            "observedType": "number",
            "inferredLevel": "ratio",
            "role": "quantity",
            "level": "ratio",
            "unit": "people",
            "label": "Margin of error (90%)"
          }
        ],
        "attribution": {
          "label": "U.S. Census Bureau, 2024 American Community Survey 1-year estimates, State-to-State Migration Flows (Table 1)",
          "url": "https://www2.census.gov/programs-surveys/demo/tables/geographic-mobility/2024/state-to-state-migration/State_to_State_Migration_Table_2024_T13.xlsx",
          "license": "U.S. public domain",
          "accessedAt": "2026-11-04T00:00:00Z",
          "qualification": "The 30 largest flows between the 50 states and DC (people 1 year and over who lived in another state one year earlier); moves from abroad, Puerto Rico and the Island Areas are not shown. Survey estimates with 90% margins of error (movers_moe): the smallest shown flows, and the largest ones left out, overlap within their margins. Arcs join 2020 state centers of population (U.S. Census Bureau, CenPop2020_Mean_ST), not actual routes."
        },
        "observationLabel": "ACS 2024",
        "name": "Largest state-to-state migration flows, ACS 2024"
      }
    ],
    "media": []
  }
}
