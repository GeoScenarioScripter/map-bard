{
  "formatVersion": "0.2.0",
  "scenes": [
    {
      "id": "columns",
      "title": "Columns",
      "narration": "USGS daily mean discharge on 2024-10-01 as columns, linear from zero: 5,580 ft³/s at Hancock, 23,600 ft³/s at Point of Rocks and 17,300 ft³/s at Little Falls. The columns rise one after another, smallest first.",
      "layers": [
        { "id": "state-context", "technique": "fill", "sourceId": "potomac-states-context" },
        { "id": "river-context", "technique": "line", "sourceId": "potomac-river-context" },
        {
          "id": "gauges",
          "technique": "column",
          "sourceId": "potomac-2024",
          "encode": { "attribute": "daily_mean_discharge", "visualVariable": "height" },
          "column": { "radiusMeters": 1800 }
        }
      ],
      "camera": { "center": [-77.55, 39.22], "zoom": 8.1, "pitch": 55, "bearing": -20 },
      "transitionIn": "cut",
      "motion": {
        "layers": [
          {
            "layerId": "gauges",
            "property": "grow",
            "stagger": { "delayMs": 300, "order": "ascending" }
          }
        ]
      },
      "annotations": [
        {
          "id": "point-of-rocks",
          "text": "Point of Rocks: 23,600 ft³/s",
          "at": [-77.5431111111111, 39.273583333333335],
          "target": {
            "kind": "features",
            "sourceId": "potomac-2024",
            "featureIds": ["USGS-01638500"]
          }
        }
      ]
    },
    {
      "id": "morph",
