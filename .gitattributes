fixtures/** text eol=lf
fixtures/**/*.png binary -eol
fixtures/**/*.jpg binary -eol
# Authored project files are hashed; keep LF on every platform.
examples/projects/** text eol=lf
examples/projects/**/*.jpg binary -eol
examples/projects/**/*.png binary -eol
# Original acquisition bytes are hashed; never normalize them on checkout.
examples/projects/first-slice/source/*.json -text
examples/projects/first-slice/source/*.geojson -text
examples/projects/first-slice/source/metadata/*.json -text
