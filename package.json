{
  "name": "mapbard-workspace",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "pnpm -r build",
    "test": "node scripts/test.mjs",
    "test:browser": "node tests/browser.smoke.mjs",
    "test:basemap:live": "node tests/basemap.live.mjs",
    "test:pack": "node tests/package.smoke.mjs",
    "lint": "eslint .",
    "format": "prettier --write .",
    "changeset": "changeset",
    "version-packages": "changeset version"
  },
  "devDependencies": {
    "@changesets/cli": "2.29.7",
    "@eslint/js": "^9.17.0",
    "@mapbard/core": "workspace:*",
    "@mapbard/knowledge": "workspace:*",
    "@mapbard/renderer": "workspace:*",
    "@types/node": "^22.10.2",
    "eslint": "^9.17.0",
    "playwright-core": "1.64.1",
    "prettier": "^3.4.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.1",
    "vitest": "^2.1.8"
  }
}
