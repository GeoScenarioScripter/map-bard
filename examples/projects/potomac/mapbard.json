        },
        "location": {
          "type": "local",
          "path": "media/potomac-context.jpg"
        },
        "name": "Potomac River at Whites Ferry",
        "mimeType": "image/jpeg",
        "width": 1704,
        "height": 2272,
        "caption": "A stream entering the Potomac at Whites Ferry.",
        "credit": "Cynthia L. Cunningham, U.S. Geological Survey (Public Domain)"
      }
    ]
  }
