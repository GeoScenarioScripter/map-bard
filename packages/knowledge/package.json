{
  "name": "@mapbard/knowledge",
  "version": "0.2.0",
  "description": "Map technique capability rules and keyless basemap and terrain catalogs for MapBard",
  "keywords": [
    "mapbard",
    "cartography",
    "basemap",
    "terrain",
    "geospatial"
  ],
  "homepage": "https://github.com/GeoScenarioScripter/map-bard/tree/main/packages/knowledge#readme",
  "bugs": "https://github.com/GeoScenarioScripter/map-bard/issues",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/GeoScenarioScripter/map-bard.git",
    "directory": "packages/knowledge"
  },
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@mapbard/schema": "workspace:*"
  }
}
