{
  "id": "sf-waterfront",
  "title": "Along the San Francisco Waterfront",
  "intent": "Introduce the San Francisco waterfront, then drill into its busiest landmark.",
  "schemaVersion": "0.1.0",
  "basemap": {
    "style": "protomaps-light",
    "pmtilesUrl": "basemap.pmtiles"
  },
  "theme": {
    "palette": ["#0b3d91", "#f4a259", "#2a9d8f"],
    "displayFont": "Fraunces",
    "bodyFont": "Inter"
  },
  "dataSources": [
    {
      "id": "landmarks",
      "name": "SF waterfront landmarks",
      "kind": "geojson",
      "path": "data/landmarks.geojson",
      "profile": {
        "geometryType": "point",
        "featureCount": 3,
        "crs": "EPSG:4326",
        "extent": [-122.4194, 37.7955, -122.3905, 37.8087],
        "attributes": [
          {
            "name": "name",
            "dataType": "string",
            "measurement": "nominal",
            "sample": ["Ferry Building", "Pier 39", "Coit Tower"]
          },
          {
            "name": "daily_visitors",
            "dataType": "number",
            "measurement": "ratio",
            "sample": [12000, 34000, 9000]
          }
        ]
      }
    }
  ],
  "mediaAssets": [
    {
      "id": "img-skyline",
      "name": "Waterfront skyline at dusk",
      "kind": "image",
      "source": "local",
      "path": "media/skyline.jpg",
      "mimeType": "image/jpeg",
      "width": 1600,
      "height": 900,
      "caption": "The Embarcadero waterfront at dusk.",
      "credit": "MapBard sample"
    },
    {
      "id": "img-ferry",
      "name": "Ferry Building clock tower",
      "kind": "image",
      "source": "local",
      "path": "media/ferry-building.jpg",
      "mimeType": "image/jpeg",
      "width": 1200,
      "height": 800,
      "caption": "The Ferry Building clock tower.",
      "credit": "MapBard sample",
      "location": [-122.3933, 37.7955]
    }
  ],
  "scenes": [
    {
      "id": "s1-overview",
      "title": "The waterfront",
      "narration": "San Francisco's eastern edge is a working waterfront turned public promenade. From the Ferry Building north to Fisherman's Wharf, a string of piers traces the bay.",
      "media": [
        {
          "assetId": "img-skyline",
          "placement": "figure",
          "caption": "Dusk over the Embarcadero."
        }
      ],
      "content": {
        "semantics": "Establish the waterfront as a continuous public edge.",
        "location": "San Francisco Embarcadero, present day",
        "geometry": "The line of piers and landmarks along the bay."
      },
      "discourse": {
        "narrativeRole": "establish",
        "emphasis": "medium",
        "readerAgency": "none"
      },
      "layers": [
        {
          "id": "lyr-landmarks-overview",
          "dataSourceId": "landmarks",
          "technique": "point",
          "encode": { "attribute": "daily_visitors", "visualVariable": "size" }
        }
      ],
      "camera": {
        "center": [-122.4005, 37.8021],
        "zoom": 12.5,
        "bearing": 0,
        "pitch": 0
      },
      "transitionIn": "ease"
    },
    {
      "id": "s2-ferry",
      "title": "At the Ferry Building",
      "narration": "The Ferry Building anchors the southern end. Once the second-busiest transit terminal in the world, today its market hall draws tens of thousands of visitors a day.",
      "mediaAnchors": [
        {
          "assetId": "img-ferry",
          "trigger": "marker",
          "label": "Ferry Building"
        }
      ],
      "content": {
        "semantics": "Zoom into the busiest landmark and read its scale.",
        "geometry": "A single point at the foot of Market Street.",
        "attribute": "daily_visitors"
      },
      "discourse": {
        "narrativeRole": "drill",
        "emphasis": "high",
        "readerAgency": "guided"
      },
      "layers": [
        {
          "id": "lyr-landmarks-graduated",
          "dataSourceId": "landmarks",
          "technique": "graduated-symbol",
          "encode": { "attribute": "daily_visitors", "visualVariable": "size" },
          "classification": { "method": "quantile", "classes": 3 }
        }
      ],
      "camera": {
        "center": [-122.3933, 37.7955],
        "zoom": 15.5,
        "bearing": 0,
        "pitch": 45
      },
      "transitionIn": "fly",
      "controls": [
        {
          "id": "ctl-symbol-size",
          "kind": "slider",
          "label": "Symbol size",
          "bindsTo": { "layerId": "lyr-landmarks-graduated", "property": "circle-radius" },
          "range": [2, 24],
          "default": 8
        }
      ]
    }
  ]
}
